{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/harness-view-guard.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/process-write-guard.js\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/process-write-guard.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__drillspark__update_diagram|mcp__claude_ai_DrillSpark__update_diagram",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/process-write-guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
